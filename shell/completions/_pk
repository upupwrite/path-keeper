# Zsh completion for path-keeper (pk).

_pk() {
    local -a commands kinds indices editors aliases
    commands=(${(f)"$(command pk completion commands 2>/dev/null)"})
    kinds=(commands indices aliases directories editors)
    indices=(${(f)"$(command pk completion indices 2>/dev/null)"})
    editors=(${(f)"$(command pk completion editors 2>/dev/null)"})
    aliases=(${(f)"$(command pk completion aliases 2>/dev/null)"})

    if (( CURRENT == 2 )); then
        _describe -t commands 'pk command' commands
        return
    fi

    case $words[2] in
        alias)
            if (( CURRENT == 3 )); then
                _values 'alias command' add remove list install
            elif [[ $words[3] == remove ]]; then
                _describe -t aliases 'alias' aliases
            elif [[ $words[3] == add ]] && (( CURRENT >= 5 )); then
                _describe -t indices 'command index' indices
            fi
            ;;
        completion|complete)
            _values 'completion kind' $kinds
            ;;
        config)
            _arguments '-editor[set the editor command]:editor:($editors)'
            ;;
        log)
            _arguments '--enable[enable logging]' '--disable[disable logging]' \
                '1:target:(global $indices)'
            ;;
        -e|--execute|-p|--point|-c|--configure|-r|--run|run)
            _describe -t indices 'command index' indices
            ;;
    esac
}

compdef _pk pk
